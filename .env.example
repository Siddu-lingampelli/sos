# --- Database ---
DATABASE_URL=postgresql://silentsos:silentsos@localhost:5432/silentsos
POSTGRES_USER=silentsos
POSTGRES_PASSWORD=silentsos
POSTGRES_DB=silentsos

# --- Auth ---
JWT_SECRET=change-me-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Services ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- AI ---
MODEL_PATHS=./models
YOLO_POSE_MODEL=yolo11n-pose.pt
WHISPER_MODEL_SIZE=tiny
AUDIO_KEYWORDS=help,emergency,please help,someone help

# --- Emergency Engine (tuned in Level 7/10) ---
MONITOR_THRESHOLD=40
ALERT_THRESHOLD=70
OBSERVATION_DURATION_SEC=10
INACTIVITY_THRESHOLD=0.02

# --- Alerts ---
ALERT_SETTINGS=default
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
