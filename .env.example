# --- Database ---
# Local dev defaults to SQLite. Production should use PostgreSQL with a
# least-privilege role and a secret managed outside the repo. NEVER copy the
# placeholder below into production — it is public knowledge.
DATABASE_URL=sqlite:///./silentsos.db
POSTGRES_USER=silentsos
POSTGRES_PASSWORD=<generate-with-python-secrets-token-urlsafe-32>
POSTGRES_DB=silentsos

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Blank generates a random per-process key and warns — tokens then die on
# restart, and any other install cannot replay them.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
# Authentication is ALWAYS enforced — there is no anonymous mode. AUTH_REQUIRED
# is retained only so old .env files still parse; setting it to false does NOT
# disable auth (fail-closed: anyone could otherwise dismiss live incidents).
AUTH_REQUIRED=true
# Public self-registration. Off by default: with it on, anyone who can reach
# the API can mint an officer account and then dismiss live incidents.
# Admins create accounts via POST /api/users/ regardless of this flag.
ALLOW_PUBLIC_REGISTRATION=false
# Optional bootstrap admin. Leave blank to ship with no default credential.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Services ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI ---
MODEL_PATHS=./models
YOLO_POSE_MODEL=yolo11n-pose.pt
WHISPER_MODEL_SIZE=tiny
AUDIO_KEYWORDS=help,emergency,please help,someone help

# --- Emergency Engine (tuned in Level 7/10) ---
MONITOR_THRESHOLD=40
ALERT_THRESHOLD=70
OBSERVATION_DURATION_SEC=10
INACTIVITY_THRESHOLD=0.02
# Seconds a heard distress event stays fused into the score. Short on purpose:
# a stale shout must not stack onto fresh vision evidence.
AUDIO_WINDOW_SEC=10

# --- Stream hardening ---
# Max simultaneous inference threads (one per camera source). Extra viewers
# share the thread; extra sources get HTTP 429.
STREAM_MAX_THREADS=4
# Comma-separated allowed source prefixes, e.g. "rtsp://cam1,http://192.168.1.".
# Empty = DENY every URL source (webcam indexes still work). Fail-closed: an
# allow-any backend fetches attacker URLs with server credentials (SSRF), so
# set this before pointing any camera at the server.
STREAM_SOURCE_ALLOWLIST=
# Server-controlled directory for incident snapshot files. DELETE only ever
# removes files inside it.
SNAPSHOT_DIR=./snapshots
# Trust X-Forwarded-For for rate-limit client IPs. Only enable behind a real
# reverse proxy that strips it — otherwise attackers rotate identities freely.
TRUST_PROXY=false
# Set true the moment TLS terminates in front (session cookie gets Secure).
SESSION_COOKIE_SECURE=false

# --- Alerts ---
ALERT_SETTINGS=default
# Optional email notifications. Leave SMTP_HOST blank for local-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# --- Privacy ---
# Resolved incidents older than this are purged at startup. 0 disables.
RETENTION_DAYS=30