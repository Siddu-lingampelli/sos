# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
backend/venv/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/build/
*.log
npm-debug.log*

# Env / secrets
.env
*.pem
*.key

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Docker / DB
postgres-data/
pgdata/
*.db
*.sqlite
*.sqlite3
# SQLite WAL sidecars (see app/db/session.py — WAL is enabled so the
# inference thread and HTTP handlers can read while one writes)
*.db-shm
*.db-wal
# Note: any .db file anywhere in the repo is now ignored, including
# backend/silentsos.db and root silentsos.db. Delete existing tracked copies
# with: git rm --cached backend/silentsos.db silentsos.db && git commit -m ...

# ML weights / media (large, local-only) — NOTE: must not match backend/app/models/
*.pt
/models/
*.onnx
*.mp4
*.avi
*.wav
*.mp3
*.onnx
*.mp4
*.avi
*.wav
*.mp3

# Misc
.claude/
*.tmp
